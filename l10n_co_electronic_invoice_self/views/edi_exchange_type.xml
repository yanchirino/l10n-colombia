<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="edi_exchange_type_view_form_dian">
        <field name="name">EDI Exchange Type Form - DIAN</field>
        <field name="model">edi.exchange.type</field>
        <field name="inherit_id" ref="edi_core_oca.edi_exchange_type_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="DIAN Colombia" name="dian_colombia">
                    <group col="1">
                        <field name="l10n_co_dian_webservice_action" />
                        <field name="l10n_co_dian_body_zipped" />
                        <field name="l10n_co_dian_document_requires_signature" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
