<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Configuración del template de salida para facturas -->
    <template id="dian_invoice_ubl_template" name="DIAN Invoice UBL Template">
        <t t-call="l10n_co_electronic_invoice_self.dian_invoice_ubl_content" />
    </template>
    <record id="edi_exchange_template_invoice_out" model="edi.exchange.template.output">
        <field name="name">Plantilla Factura Electrónica DIAN UBL</field>
        <field name="code">dian_invoice_ubl</field>
        <field name="backend_type_id" ref="edi_backend_type_dian_self" />
        <field name="output_type">xml</field>
        <field name="generator">qweb</field>
        <field name="template_id" ref="dian_invoice_ubl_template" />
        <field name="prettify" eval="True" />
    </record>

    <!-- Configuración del template de salida para notas crédito -->
    <template id="dian_credit_note_ubl_template" name="DIAN Credit Note UBL Template">
        <t t-call="l10n_co_electronic_invoice_self.dian_credit_note_ubl_content" />
    </template>
    <record id="edi_exchange_template_refund_out" model="edi.exchange.template.output">
        <field name="name">Plantilla Nota Crédito Electrónica DIAN UBL</field>
        <field name="code">dian_credit_note_ubl</field>
        <field name="backend_type_id" ref="edi_backend_type_dian_self" />
        <field name="output_type">xml</field>
        <field name="generator">qweb</field>
        <field name="template_id" ref="dian_credit_note_ubl_template" />
        <field name="prettify" eval="True" />
    </record>

    <!-- Configuración del template de salida para consulta de rangos numeración -->
    <template
        id="dian_numbering_range_query_template"
        name="DIAN Numbering Range Query Template"
    >
        <t
            t-call="l10n_co_electronic_invoice_self.dian_numbering_range_query_content"
        />
    </template>
    <record
        id="edi_exchange_template_numbering_range_query_out"
        model="edi.exchange.template.output"
    >
        <field name="name">Plantilla Consulta Rangos Numeración Electrónica DIAN</field>
        <field name="code">dian_numbering_range_query</field>
        <field name="backend_type_id" ref="edi_backend_type_dian_self" />
        <field name="output_type">xml</field>
        <field name="generator">qweb</field>
        <field name="template_id" ref="dian_numbering_range_query_template" />
        <field name="prettify" eval="True" />
    </record>
</odoo>
