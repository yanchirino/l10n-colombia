<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Webservice Backend para DIAN Producción -->
    <record id="webservice_backend_dian_self_prod" model="webservice.backend">
        <field name="name">DIAN Colombia - WSDL Producción</field>
        <field name="tech_name">dian_prod</field>
        <field name="protocol">http</field>
        <field name="url">https://vpfe.dian.gov.co/WcfDianCustomerServices.svc</field>
        <field name="auth_type">none</field>
        <field name="content_type">application/soap+xml</field>
    </record>

    <!-- Webservice Backend para DIAN Pruebas -->
    <record id="webservice_backend_dian_self_test" model="webservice.backend">
        <field name="name">DIAN Colombia - WSDL Habilitación</field>
        <field name="tech_name">dian_test</field>
        <field name="protocol">http</field>
        <field
            name="url"
        >https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc</field>
        <field name="auth_type">none</field>
        <field name="content_type">application/soap+xml</field>
    </record>
</odoo>
