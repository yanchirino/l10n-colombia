<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Configuración del tipo de intercambio para facturas electrónicas -->
    <record id="edi_exchange_type_invoice_out" model="edi.exchange.type">
        <field name="name">Enviar Factura Electrónica DIAN</field>
        <field name="code">invoice_out</field>
        <field name="backend_type_id" ref="edi_backend_type_dian_self" />
        <field name="backend_id" ref="edi_backend_dian_self_default" />
        <field name="direction">output</field>
        <field name="exchange_filename_pattern">{record.name}_{record.id}</field>
        <field name="exchange_file_ext">xml</field>
        <field name="exchange_file_auto_generate" eval="True" />
        <field name="quick_exec" eval="True" />
        <field
            name="output_template_allowed_ids"
            eval="[(6, 0, [ref('l10n_co_electronic_invoice_self.edi_exchange_template_invoice_out')])]"
        />
        <field
            name="output_template_id"
            ref="l10n_co_electronic_invoice_self.edi_exchange_template_invoice_out"
        />
        <field
            name="generate_model_id"
            ref="l10n_co_electronic_invoice_self.model_l10n_co_dian_self_output_handler"
        />
        <field
            name="send_model_id"
            ref="l10n_co_electronic_invoice_self.model_l10n_co_dian_self_output_handler"
        />
        <field
            name="l10n_co_dian_webservice_action"
        >http://wcf.dian.colombia/IWcfDianCustomerServices/SendBillSync</field>
        <field name="l10n_co_dian_document_requires_signature" eval="True" />
    </record>

