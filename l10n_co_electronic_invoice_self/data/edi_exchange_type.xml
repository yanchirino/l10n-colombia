    <!-- Configuración del tipo de intercambio para consulta de rangos numeración -->
    <record
        id="edi_exchange_type_numbering_range_query_out_response"
        model="edi.exchange.type"
    >
        <field name="name">Rangos Numeración Electrónica DIAN - Respuesta</field>
        <field name="code">get_numbering_range_response</field>
        <field name="backend_type_id" ref="edi_backend_type_dian_self" />
        <field name="backend_id" ref="edi_backend_dian_self_default" />
        <field name="direction">input</field>
        <field name="exchange_file_auto_generate" eval="False" />
        <field name="quick_exec" eval="True" />
        <field name="exchange_file_ext">xml</field>
        <field
            name="exchange_filename_pattern"
        >dian_numbering_range_on_{exchange_record.create_date}</field>
    </record>

    <record id="edi_exchange_type_numbering_range_query_out" model="edi.exchange.type">
